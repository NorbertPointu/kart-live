rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      // The single event is readable by authenticated team devices only.
      allow read: if request.auth != null;
      // Only the Firebase Auth administrator account can update event state.
      allow create, update: if request.auth != null && request.auth.uid == 'REPLACE_WITH_ADMIN_UID';
      allow delete: if false;
    }
  }
}
